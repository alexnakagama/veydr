# Check out text files with LF on every OS, so tests that compare text see the same bytes on Windows.
* text=auto eol=lf

# Byte-exact files: images, and fixtures whose bytes are what a test compares.
*.bin binary
*.png binary
*.ico binary
*.jsonl binary

# The committed Windows probe results are reviewed as text (assess-windows-platform design D4). Later
# patterns win, so this must stay after the *.jsonl line above. `binary` is a macro (-diff -merge -text):
# `text` alone would leave it set, so it is unset and its parts are set back explicitly.
test/windows-probe/results/*.jsonl -binary text eol=lf diff merge
